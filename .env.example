# ================================================================
# Configuración AsisNexo — copia como ".env" en el VPS y rellena
# ================================================================

# PostgreSQL: usuario, contraseña y nombre de la base de datos.
# Usa contraseña larga y segura (inventa una o usa un generador).
POSTGRES_USER=asisnexo
POSTGRES_PASSWORD=--
POSTGRES_DB=asisnexo

# El hash de esta contraseña se "hornea" al PRIMER arranque de la API.
# Después, los cambios se hacen desde el panel (/admin → Seguridad) y
# esta variable queda sin efecto.
ADMIN_PASSWORD=--

# Token público-encubierto que menu.html envía en POST /api/order
# (algo aleatorio; no es seguridad real porque el cliente lo expone).
ORDER_TOKEN=--

# Token del agente impresor local (print-agent) y su polling.
AGENT_TOKEN=--

# Secreto para firmar las sesiones JWT del panel /admin.
SESSION_SECRET=--

# OPCIONAL: zona horaria para estadísticas (default America/Caracas).
APP_TZ=America/Caracas

# OPCIONAL: 'true' si el sitio corre detrás de HTTPS para cookies seguras.
COOKIE_SECURE=false